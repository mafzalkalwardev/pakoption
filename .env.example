# ---------------------------------------------------------------------------
# PakOption — environment
#
# Copy to /etc/pakoption.env on the VPS (and to .env for local work).
# Never commit real passwords. NEXT_PUBLIC_SITE_URL is inlined by `next build`.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://pakoption.induswebagency.com"

# --- Postgres (self-hosted on the same VPS) ---------------------------------
# Use the same URL for both when you are not using a pooler.
DATABASE_URL="postgresql://pakoption:CHANGE_ME@127.0.0.1:5432/pakoption"
DIRECT_URL="postgresql://pakoption:CHANGE_ME@127.0.0.1:5432/pakoption"

# --- Auth -------------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"
# First admin, created by `npm run db:seed` (demo listings stay off unless SEED_DEMO=1).
ADMIN_EMAIL="admin@pakoption.local"
ADMIN_PASSWORD="CHANGE_ME"

# --- Cron -------------------------------------------------------------------
# openssl rand -hex 32
# Required. /api/cron/close-auctions rejects requests without it.
CRON_SECRET="CHANGE_ME"

# --- Uploads ----------------------------------------------------------------
# Directory the app writes listing photos into. nginx aliases /uploads/ here.
UPLOAD_DIR="/var/lib/pakoption/uploads"

# --- Email (optional) -------------------------------------------------------
# Leave SMTP_HOST empty and the app still runs. Registration marks the email
# tier immediately, and mail is skipped. Set these to use a local SMTP daemon
# such as Postfix on 127.0.0.1:25.
SMTP_HOST=""
SMTP_PORT="25"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="PakOption <no-reply@pakoption.induswebagency.com>"

# --- Optional demo data -----------------------------------------------------
# SEED_DEMO=1 npm run db:seed
# loads the sample cars. Leave unset for an empty marketplace plus the admin user.
SEED_DEMO=""
