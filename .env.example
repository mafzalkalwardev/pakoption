# ---------------------------------------------------------------------------
# PakOption — environment
#
# The app runs WITHOUT any of these. With no DATABASE_URL the repository layer
# falls back to a deterministic in-memory seed dataset, so the first Vercel
# deploy works with zero configuration. Fill these in when you provision
# Supabase and want real persistence.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database (Supabase Postgres) -------------------------------------------
# Pooled connection (PgBouncer, port 6543) — used by the app at runtime
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) — used by `prisma migrate`
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Supabase (storage + realtime) ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Cron -------------------------------------------------------------------
# Protects /api/cron/* — generate with: openssl rand -hex 32
CRON_SECRET=""

# --- Notifications (optional) -----------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="PakOption <no-reply@pakoption.pk>"

# --- SMS / OTP (optional) ---------------------------------------------------
SMS_PROVIDER_KEY=""
