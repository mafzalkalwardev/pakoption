[Unit]
Description=PakOption (Next.js)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/pakoption
Environment=NODE_ENV=production
Environment=NEXT_PUBLIC_SITE_URL=https://pakoption.induswebagency.com
ExecStart=/usr/bin/npm run start -- -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=5
# next start does not need a database. Do not set DATABASE_URL until a
# repository adapter actually reads it.

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
